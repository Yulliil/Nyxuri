## Nyxuri SwayFX rules configuration

# Swayfx doesn't have a native overview mode, place-within-backdrop option from niri will not be ported

# <namespace> parameter of layer_effects option does not support regex
layer_effects "noctalia-bar-bar" {
	shadows disable
	blur disable
}

for_window [app_id="^org\.quickshell$" title="^nyxuri-settings"] floating enable, resize 65 ppt 75 ppt

for_window [app_id="^dev\.noctalia\.Noctalia$"] floating enable, resize 65 ppt 75 ppt

# Note: default tiling, maybe floating better?
for_window [app_id="^(gnome-control-center|pavucontrol|nm-connection-editor)$"] resize set width 50 ppt

for_window [app_id="^(org\.gnome\.Calculators|gnome-calculators|galculator|blueman-manager|org\.gnome\.Nautilus|xdg-desktop-portal-(gnome|gtk))$"] floating enable

# Not needed, it works fine on swayfx
# for_window [app_id=r"^steam$" title="^notificationtoasts_\\d+_desktop$"]

for_window [app_id="zoom"] floating enable

for_window [app_id="wine"] floating enable

# hide windowed wine tray on wayland, criteria for wineboot.exe removed.
for_window [app_id="(?i)^explorer\.exe$" title="(?i)^(|Wine System Tray|Wine)$"] floating enable, move position -9999 px -9999 px

# Note: "window rules from glassy-niri" in Niri windows rules are all about opacity and blur - we already have these options in effect configuration file. Omitted

# Note: SwayFX does not support window-specific VRR configuration. VRR window rules for web browsers in Niri configuration ommited.

# Game window rules regenerated by LLM. I'm too lazy to rewrite them.
# Note: Window rules does not support window-specific border, hiding border on these applications will be omitted :(
# Also, there's a lot of exclude rules in Niri configuration - what match rule hits really contain excluded apps? Omitted
for_window [app_id="(^steam_app_*|^gamescope$|com\.valvesoftware\.Steam\.Ultility\.gamescope$)"] opacity 1, blur disable, corner_radius 0, shadows disable, border none

