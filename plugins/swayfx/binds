## Nyxuri SwayFX binds configuration

set $mod Mod4

bindsym {

	# Our inexisted overview (placeholder - TODO: implement SOV later)
	bindsym $mod+Tab exec inexisted-overviewwwwwwwww

	# Close focused window
	$mod+q kill

	# Exit SwayFX
	$mod+Shift+q swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

	# Reload SwayFX configuration
	$mod+Shift+r reload

	# Lockscreen (Desktop shell gateway script)
	$mod+l exec ~/.config/sway/scripts/shell-action.sh lock

	# Help
	# TODO: Need to implement it manually
	$mod+Slash exec inexisted-help-menuuuuuuuuuuu

	# Terminal emulator (Kitty)
	$mod+Return exec kitty

	# File manager (Nautilus)
	$mod+e exec nautilus

	# Launcher (Desktop shell gateway script)
	$mod+r exec ~/.config/sway/scripts/shell-action.sh launcher

	# Power/session menu (Desktop shell gateway script)
	$mod+x exec ~/.config/sway/scripts/shell-action.sh session

	# Settings (Desktop shell gateway script)
	--no-repeat $mod+i exec exec ~/.config/sway/scripts/shell-action.sh settings

	# Clipboard history (Desktop shell gateway script)
	$mod+v exec exec ~/.config/sway/scripts/shell-action.sh clipboard

	# Nyxuri wallpaper picker (Desktop shell gateway script)
	--no-repeat $mod+w exec ~/.config/sway/scripts/shell-action.sh wallpaper-picker

	# Random wallpaper (Desktop shell gateway script)
	$mod+ctrl+w exec ~/.config/sway/scripts/shell-action.sh wallpaper-random

	# Eyecare
	$mod+n exec ~/.config/sway/scripts/toggle-eyecare.sh

	# Scaratchpad Console
	$mod+Grave exec ~/.config/sway/scripts/swayfx-scratch-toggle.sh kitty

	# Orbit Launcher (Desktop shell gateway script)
	# TODO: extra modifications needed - SwayFX supports "move position pointer"
	--no-repeat $mod+a exec ~/.config/sway/scripts/shell-action.sh radial-launcher
	# TODO: extra modifications need - usability of MouseForward in SwayFX. Sadly I don't have a gaming mouse :(
	--no-repeat $mod+MouseForward exec ~/.config/sway/scripts/shell-action.sh radial-launcher

	# Translate (Desktop shell gateway script) 
	# TODO: maybe extra modifications on the translator py script needed
	--no-repeat Alt+e exec exec ~/.config/sway/scripts/shell-action.sh translate
	
	# In-workspaces
	# Focus
	$mod+Left focus left
	$mod+Up focus up
	$mod+Right focus right
	$mod+Down focus down
	# Move
	$mod+Shift+Left move left
	$mod+Shift+Up move up
	$mod+Shift+Right move right
	$mod+Shift+Down move down

	# Inter-workspaces
	# Focus a workspace
	$mod+1 workspace number 1
	$mod+2 workspace number 2
	$mod+3 workspace number 3
	$mod+4 workspace number 4
	$mod+5 workspace number 5
	$mod+6 workspace number 6
	$mod+7 workspace number 7
	$mod+8 workspace number 8
	$mod+9 workspace number 9
	$mod+0 workspace number 10
	$mod+z workspace prev
	$mod+c workspace next
	# Move focused container to a workspace
	$mod+Shift+1 move container to workspace number 1
	$mod+Shift+2 move container to workspace number 2
	$mod+Shift+3 move container to workspace number 3
	$mod+Shift+4 move container to workspace number 4
	$mod+Shift+5 move container to workspace number 5
	$mod+Shift+6 move container to workspace number 6
	$mod+Shift+7 move container to workspace number 7
	$mod+Shift+8 move container to workspace number 8
	$mod+Shift+9 move container to workspace number 9
	$mod+Shift+0 move container to workspace number 10
	$mod+Shift+z move container to workspace prev
	$mod+Shift+c move container to workspace next

	# Toggle window floating state
	$mod+t floating toggle
	# Switch focus between floating and tiled layers
	$mod+Shift+t mode_toggle

	# Tabbed group
	# TODO: More investigation need - I'm not a tab layout user
	$mod+t layout toggle tabbed split

	# Fullscreen
	$mod+Shift+f fullscreen

	# Resize
	# Note: Resizing is implemented completely different from the same feature in Niri
	# Super+s to enter resize mode, esc to exit resize mode
	# We use right side and bottom side as the criterion, all modifications are seen to these two sides:
	# Up and Left to shrink, Right and Down to grow
	$mod+s mode "resize" 

}

mode "resize" {
	bindsym {
		Left resize shrink width 40px
		Right resize grow width 40px
		Up resize shrink height 40px
		Down resize grow height 40px
		
		# Fine-tune with Shift
		Shift+Left resize shrink width 40px
		Shift+Right resize grow width 40px
		Shift+Up resize shrink height 40px
		Shift+Down resize grow height 40px

		# Exit resize mode
		Escape mode "default"
	}
}



